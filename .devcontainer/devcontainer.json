{
  "name": "Testes Caixa Preta",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "jnoortheen.nix-ide"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          },
          "nix-develop": {
            "path": "/home/vscode/.nix-profile/bin/nix",
            "args": [
              "develop"
            ],
            "icon": "package"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postStartCommand": "if [ \"$(stat -c '%u' /nix)\" != \"$(id -u)\" ]; then sudo chown -R $(id -u):$(id -g) /nix; fi",
  "remoteUser": "vscode"
}